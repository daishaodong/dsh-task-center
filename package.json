{
  "name": "dsh-task-center",
  "version": "1.7.0",
  "private": true,
  "description": "DeepSeek Harness plugin: one place to see every Session whose Agent is running or waiting for you, with macOS notifications and project ordering by recent activity.",
  "type": "module",
  "license": "MIT",
  "author": "daishaodong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daishaodong/dsh-task-center.git"
  },
  "homepage": "https://github.com/daishaodong/dsh-task-center#readme",
  "bugs": {
    "url": "https://github.com/daishaodong/dsh-task-center/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "macos-notifications",
    "electron",
    "productivity"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
